      "point": "运行中的 WAL 文件与独立镜像的差别（文件头偏移 18、19 字节）",
      "bad": {
        "path": "02-wal-runtime-file/bad/sensor-reading-wal.sqlite",
        "sha256": "ba07a50dadb151be2c6093ac976171de8a4fbc8fdd5cb1769e581d96c512977b",
        "size": 8192,
        "journal_mode": "wal",
        "header_bytes_18_19_hex": "0202",
        "sidecars_left_in_bad_dir": [],
        "expected_rejection": {
          "http": 422,
          "code": "image_journal"
        }
      },
      "fix_steps": [
        "复制坏样件（不直接改原件）",
        "PRAGMA wal_checkpoint(TRUNCATE);",
        "PRAGMA journal_mode=DELETE;"
